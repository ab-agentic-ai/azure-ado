# Copy to .env. Keep the tunnel token itself in .secrets/cloudflare-tunnel-token.
# Used by --mode named only. Use a hostname from the Cloudflare Public Hostname route.
ADO_API_URL=https://api.your-domain.example
PAGES_ORIGIN=https://ab-agentic-ai.github.io
# Required by the default Quick Tunnel mode; replace with the email allowed to connect.
QUICK_TUNNEL_ALLOWED_EMAIL=you@example.com
CLOUDFLARE_TUNNEL_TOKEN_FILE=.secrets/cloudflare-tunnel-token
CORS_ORIGINS=https://ab-agentic-ai.github.io,http://localhost:5173,http://127.0.0.1:5173
API_PORT=8000
